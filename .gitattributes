* text=auto eol=lf
*.ps1 text eol=crlf

# Generator output: regenerate, never hand-edit (CLAUDE.md, "Status"). GitHub collapses these in
# pull request diffs. To leave them out of a local diff or log:
#   git diff main -- ':(attr:!linguist-generated)'
src/reflection/** linguist-generated=true
src/reflection_types/** linguist-generated=true
src/reflection_statics/** linguist-generated=true
src/clones/** linguist-generated=true
src/tables/** linguist-generated=true
src/lifted/** linguist-generated=true
include/base/reflection/UnkClassGetters.h linguist-generated=true
docs/commands.md linguist-generated=true
data/functions/*.csv linguist-generated=true
data/reflection_types.csv linguist-generated=true
data/tu_map.csv linguist-generated=true
data/library_symbols.csv linguist-generated=true
data/nvn_procs.csv linguist-generated=true

# Every branch adds its journal entry at the top of the session log, so two branches always touch
# the same lines. The union driver keeps both sides' lines in a local `git merge` instead of
# stopping on a conflict (check the order of the two entries afterwards). GitHub's own conflict
# check may still report the conflict; merging main into the branch locally then resolves it.
docs/JOURNAL.md merge=union
